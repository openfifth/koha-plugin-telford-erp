[% USE KohaDates %]
[% WRAPPER 'wrapper-staff-tool-plugin.inc' method="report" plugin_title="Telford ERP Integration" %]
    <h1>Run Telford ERP export</h1>
    <p>Generates a real batch for every closed, not-yet-submitted invoice with a closed date in this range (inclusive), and delivers it via the configured transport. This is not a preview - running it consumes a batch id and marks the included invoices as submitted.</p>
    <form method="get">
        <input type="hidden" name="class" value="[% CLASS %]"/>
        <input type="hidden" name="method" value="report"/>
        <fieldset class="rows">
            <ol>
                <li>
                    <label for="from">From:</label>
                    <input type="date" id="from" name="from" required="required"/>
                </li>
                <li>
                    <label for="to">To:</label>
                    <input type="date" id="to" name="to" required="required"/>
                </li>
            </ol>
        </fieldset>
        <fieldset class="action">
            <input type="submit" class="btn btn-primary" value="Generate and send"/>
        </fieldset>
    </form>
    <p><a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">Manage submitted invoices &amp; run history</a></p>
[% END #/ WRAPPER wrapper-staff-tool-plugin.inc %]
