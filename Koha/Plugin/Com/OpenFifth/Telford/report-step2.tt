[% USE KohaDates %]
[% WRAPPER 'wrapper-staff-tool-plugin.inc' method="report" plugin_title="Telford ERP Integration" %]
    <h1>Telford ERP export: [% from %] to [% to %]</h1>

    [% IF batch.num_trans %]
        [% IF batch.delivered %]
            <div class="alert alert-info">Delivered <strong>[% batch.filename %]</strong> and marked [% batch.invoice_ids.size %] invoice(s) as submitted.</div>
        [% ELSIF batch.error %]
            <div class="alert alert-danger">Batch <strong>[% batch.batch_id %]</strong> was generated but delivery failed: [% batch.error | html %]. Invoices were <strong>not</strong> marked as submitted, so this range is safe to re-run once the problem is fixed.</div>
        [% END %]

        <div class="page-section">
            <table>
                <tr><th>Batch id</th><td>[% batch.batch_id %]</td></tr>
                <tr><th>Lines</th><td>[% batch.num_trans %]</td></tr>
                <tr><th>Total debits (pence)</th><td>[% batch.total_debits %]</td></tr>
                <tr><th>Total credits (pence)</th><td>[% batch.total_credits %]</td></tr>
                <tr><th>Invoices included</th><td>[% batch.invoice_ids.size %]</td></tr>
            </table>
        </div>
        <!-- /.page-section -->

        <h2>Raw batch text</h2>
        <div class="page-section">
            <textarea rows="15" cols="120" readonly="readonly">[% batch.text %]</textarea>
        </div>
        <!-- /.page-section -->
    [% ELSE %]
        <div class="alert alert-info">No closed, not-yet-submitted invoices found in this range - or every candidate invoice is missing its <strong>Billing date</strong> or its vendor's <strong>Account number</strong> in Koha, both of which are required before it can be exported.</div>
    [% END %]

    <p><a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=report">Run another report</a></p>
[% END #/ WRAPPER wrapper-staff-tool-plugin.inc %]
