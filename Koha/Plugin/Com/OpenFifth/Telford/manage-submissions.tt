[% USE KohaDates %]
[% WRAPPER 'wrapper-staff-tool-plugin.inc' method="tool" plugin_title="Telford ERP Integration" %]
    <h1>Telford ERP Integration: submissions &amp; run history</h1>

    <h2>Submitted invoices</h2>
    <p>Clearing an invoice here does not undo anything already sent - it just lets that invoice be picked up and sent again on the next run (e.g. after fixing bad data).</p>
    <form method="post">
        <input type="hidden" name="class" value="[% CLASS %]"/>
        <input type="hidden" name="method" value="tool"/>
        <input type="hidden" name="action" value="clear"/>
        <table>
            <thead>
                <tr>
                    <th></th>
                    <th>Invoice number</th>
                    <th>Submitted at</th>
                    <th>Submitted by</th>
                    <th>Filename</th>
                </tr>
            </thead>
            <tbody>
                [% FOREACH row IN submitted_invoices %]
                <tr>
                    <td><input type="checkbox" name="invoiceid" value="[% row.invoiceid %]"/></td>
                    <td>[% row.invoicenumber | html %]</td>
                    <td>[% row.submitted_at | $KohaDates with_hours => 1 %]</td>
                    <td>[% row.submitted_by | html %]</td>
                    <td>[% row.filename | html %]</td>
                </tr>
                [% END %]
            </tbody>
        </table>
        <fieldset class="action">
            <input type="submit" value="Clear selected (allow resubmission)"/>
        </fieldset>
    </form>

    <h2>Run history</h2>
    <table>
        <thead>
            <tr>
                <th>Run at</th>
                <th>Status</th>
                <th>Invoices</th>
                <th>Filename</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            [% FOREACH run IN runs %]
            <tr>
                <td>[% run.run_at | $KohaDates with_hours => 1 %]</td>
                <td>[% run.status | html %]</td>
                <td>[% run.invoices_found %]</td>
                <td>[% run.filename | html %]</td>
                <td>[% run.message | html %]</td>
            </tr>
            [% END %]
        </tbody>
    </table>
[% END #/ WRAPPER wrapper-staff-tool-plugin.inc %]
